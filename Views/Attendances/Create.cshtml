@model Attendance
@{
	ViewData["Title"] = "Add Attendance";
}

<h1 class="mb-4">Add Attendance</h1>

<div class="col-md-6">
	<form asp-action="Create" method="post">
		<div asp-validation-summary="All" class="text-danger"></div>
		<input type="hidden" asp-for="TrainingSessionId" />
		<button type="submit" class="btn btn-primary">Save</button>
		<a asp-controller="TrainingSessions" asp-action="Index" class="btn btn-secondary">Cancel</a>
	</form>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}