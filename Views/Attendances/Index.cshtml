@model IEnumerable<AttendanceViewModel>
@{
    ViewData["Title"] = "Attendances";
}

@if (ViewBag.AcademyName != null)
{
    <h1 class="mb-3">Attendances - @ViewBag.AcademyName</h1>
}
else
{
    <h1 class="mb-4">Attendances</h1>
}

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Academy</th>
            <th>Practitioner</th>
            <th>DateOfTheTraining</th>
            <th>StartTime</th>
            <th>DurationOfTheTraining</th>
            <th>TrainingType</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var attendance in Model)
        {
            <tr>
                <td>@attendance.AcademyName</td>
                <td>@attendance.PractitionerName</td>
                <td>@attendance.DateOfTheTraining</td>
                <td>@attendance.StartTime</td>
                <td>@attendance.DurationOfTheTraining</td>
                <td>@attendance.TrainingType</td>
            </tr>
        }
    </tbody>
</table>