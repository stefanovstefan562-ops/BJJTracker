@using MyMvcApp.Models.Enums
@model Practitioner
@{
	ViewData["Title"] = "Edit Practitioner";
}

<h1 class="mb-4">Edit Practitioner</h1>

<div class="col-md-6">
	<form asp-action="Edit" method="post">
		<input type="hidden" asp-for="Id" />

		<div class="mb-3">
			<label asp-for="FirstName" class="form-label"></label>
			<input asp-for="FirstName" class="form-control" />
			<span asp-validation-for="FirstName" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="LastName" class="form-label"></label>
			<input asp-for="LastName" class="form-control" />
			<span asp-validation-for="LastName" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="AcademyId" class="form-label"></label>
			<select asp-for="AcademyId" class="form-select" asp-items="@(new SelectList(ViewBag.Academy, "Id", "AcademyName"))">
				<option value="">No Academy</option>
			</select>
			<span asp-validation-for="AcademyId" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="CurrentBelt" class="form-label"></label>
			<select asp-for="CurrentBelt" class="form-select" asp-items="Html.GetEnumSelectList<BeltRank>()"></select>
			<span asp-validation-for="CurrentBelt" class="text-danger"></span>
		</div>

		<button type="submit" class="btn btn-primary">Save</button>
		<a asp-action="Index" class="btn btn-secondary">Cancel</a>
	</form>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}