@model IEnumerable<Practitioner>
@{
	ViewData["Title"] = "Practitioners";
	var userPractitionerId = (int?)ViewBag.UserPractitionerId;
}
<h1 class="mb-4">Practitioners</h1>
@if (User.IsInRole("Practitioner") && userPractitionerId == null)
{
	<a asp-action="Create" class="btn btn-primary mb-3">Create New Practitioner</a>
}
<table class="table table-striped table-hover align-middle">
	<thead>
		<tr>
			<th>FirstName</th>
			<th>LastName</th>
			<th>Academy</th>
			<th>CurrentBelt</th>
			<th>Actions</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var practitioner in Model)
		{
			<tr>
				<td>@practitioner.FirstName</td>
				<td>@practitioner.LastName</td>
				<td>@practitioner.Academy?.AcademyName</td>
				<td>@practitioner.CurrentBelt</td>
				<td>
					@if (User.IsInRole("Practitioner") && userPractitionerId == practitioner.Id)
					{
						<a asp-action="Edit" asp-route-id="@practitioner.Id" class="btn btn-sm btn-outline-primary">Edit</a>
					}
					@if (User.IsInRole("Practitioner") && userPractitionerId == practitioner.Id)
					{
						<form asp-action="Delete" asp-route-id="@practitioner.Id" method="post" class="d-inline">
							<button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
						</form>
					}
				</td>
			</tr>
		}
	</tbody>
</table>