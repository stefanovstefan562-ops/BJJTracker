@model IEnumerable<Practitioner>
<table>
    <thead>
        <tr>
            <th>FirstName</th>
            <th>LastName</th>
            <th>Academy</th>
            <th>CurrentBelt</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var practitioner in Model)
        {
            <tr>
                <td>@practitioner.FirstName</td>
                <td>@practitioner.LastName</td>
                <td>@practitioner.Academy?.AcademyName</td>
                <td>@practitioner.CurrentBelt</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@practitioner.Id">Edit</a>
                    <form asp-action="Delete" asp-route-id="@practitioner.Id" method="post" style="display:inline">
                        <button type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>