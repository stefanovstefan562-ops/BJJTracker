@{
	ViewData["Title"] = "Home";
}

<div class="px-4 py-5 my-5 text-center">
	<h1 class="display-5 fw-bold text-body-emphasis">BJJ Tracker</h1>
	<div class="col-lg-6 mx-auto">
		<p class="lead mb-4">
			BJJ Tracker helps Brazilian Jiu-Jitsu academies manage their training schedule and lets practitioners track their attendance and sparring sessions.
		</p>
	</div>
</div>
<div class="row mt-4">
	<div class="col-md-6 mb-3">
		<div class="card h-100">
			<div class="card-body">
				<h5 class="card-title">For academies</h5>
				<ul>
					<li>Create your academy</li>
					<li>Build the training schedule</li>
					<li>Manage the catalog of techniques</li>
					<li>See the attendance at your trainings</li>
				</ul>
			</div>
		</div>
	</div>
	<div class="col-md-6 mb-3">
		<div class="card h-100">
			<div class="card-body">
				<h5 class="card-title">For practitioners</h5>
				<ul>
					<li>Create your practitioner profile</li>
					<li>Record your attendance at trainings</li>
					<li>Add your sparring sessions</li>
					<li>Browse the techniques</li>
				</ul>
			</div>
		</div>
	</div>
</div>