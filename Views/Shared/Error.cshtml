@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="text-center mt-5">
    <h1 class="display-4">500</h1>
    <h2 class="mb-3">Something went wrong</h2>
    <p>An unexpected error occurred. Please try again later.</p>
    @if (Model.ShowRequestId)
    {
        <p class="text-muted">Request ID: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to home</a>
</div>