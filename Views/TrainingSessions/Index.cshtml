@model PagedResult<TrainingSessionViewModel>
@{
	ViewData["Title"] = "Training Sessions";
	var userAcademyId = (int?)ViewBag.UserAcademyId;
}
<h1 class="mb-4">Training Sessions</h1>
<form asp-action="Index" method="get" class="row g-2 mb-3">
	<div class="col-auto">
		<input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by academy" />
	</div>
	<div class="col-auto">
		<button type="submit" class="btn btn-outline-primary">Search</button>
	</div>
</form>
<table class="table table-striped table-hover align-middle">
	<thead>
		<tr>
			<th>Academy</th>
			<th>DateOfTheTraining</th>
			<th>DurationOfTheTraining</th>
			<th>StartTime</th>
			<th>TrainingType</th>
			<th>Actions</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var trainingSession in Model.Items)
		{	
			<tr>
				<td>@trainingSession.AcademyName</td>
				<td>@trainingSession.DateOfTheTraining</td>
				<td><duration value="@trainingSession.DurationOfTheTraining"></duration></td>
				<td>@trainingSession.StartTime</td>
				<td>@trainingSession.TrainingType</td>
				<td>
					@if (User.IsInRole("Academy") && userAcademyId == trainingSession.AcademyId)
					{
						<a asp-action="Edit" asp-route-id="@trainingSession.Id" class="btn btn-sm btn-outline-primary">Edit</a>
					}
					@if (User.IsInRole("Practitioner"))
					{
						<a asp-controller="Attendances" asp-action="Create" asp-route-trainingSessionId="@trainingSession.Id" class="btn btn-sm btn-outline-success">Add Attendance</a>
					}
					@if (User.IsInRole("Academy") && userAcademyId == trainingSession.AcademyId)
					{
						<form asp-action="Delete" asp-route-id="@trainingSession.Id" method="post" class="d-inline">
							<button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
						</form>
					}
				</td>
			</tr>
		}
	</tbody>
</table>
@if (Model.TotalPages > 1)
{
	<nav>
		<ul class="pagination">
			<li class="page-item @(Model.HasPrevious ? "" : "disabled")">
				<a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search">Previous</a>
			</li>
			<li class="page-item disabled">
				<span class="page-link">Page @Model.Page of @Model.TotalPages</span>
			</li>
			<li class="page-item @(Model.HasNext ? "" : "disabled")">
				<a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search">Next</a>
			</li>
		</ul>
	</nav>
}