@model IEnumerable<TrainingSession>
@{
	ViewData["Title"] = "Training Sessions";
	var userAcademyId = (int?)ViewBag.UserAcademyId;
}
<h1 class="mb-4">Training Sessions</h1>

<table class="table table-striped table-hover align-middle">
	<thead>
		<tr>
			<th>Academy</th>
			<th>DateOfTheTraining</th>
			<th>DurationOfTheTraining</th>
			<th>StartTime</th>
			<th>TrainingType</th>
			<th>Actions</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var trainingSession in Model)
		{
			<tr>
				<td>@trainingSession.Academy?.AcademyName</td>
				<td>@trainingSession.DateOfTheTraining</td>
				<td>@trainingSession.DurationOfTheTraining</td>
				<td>@trainingSession.StartTime</td>
				<td>@trainingSession.TrainingType</td>
				<td>
					@if (User.IsInRole("Academy") && userAcademyId == trainingSession.AcademyId)
					{
						<a asp-action="Edit" asp-route-id="@trainingSession.Id" class="btn btn-sm btn-outline-primary">Edit</a>
					}
					@if (User.IsInRole("Practitioner"))
					{
						<a asp-controller="Attendances" asp-action="Create" asp-route-trainingSessionId="@trainingSession.Id" class="btn btn-sm btn-outline-success">Add Attendance</a>
					}
					@if (User.IsInRole("Academy") && userAcademyId == trainingSession.AcademyId)
					{
						<form asp-action="Delete" asp-route-id="@trainingSession.Id" method="post" class="d-inline">
							<button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
						</form>
					}
				</td>
			</tr>
		}
	</tbody>
</table>
