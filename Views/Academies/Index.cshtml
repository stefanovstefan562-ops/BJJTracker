@model IEnumerable<Academy>
@{
    ViewData["Title"] = "Academies";
    var userAcademyId = (int?)ViewBag.UserAcademyId;
}
<h1 class="mb-4">Academies</h1>
@if (User.IsInRole("Academy") && userAcademyId == null)
{
    <a asp-action="Create" class="btn btn-primary mb-3">Create New Academy</a>
}
<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>AcademyName</th>
            <th>AcademyAddress</th>
            <th>AcademyDescription</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var academy in Model)
        {
            <tr>
                <td>@academy.AcademyName</td>
                <td>@academy.AcademyAddress</td>
                <td>@academy.AcademyDescription</td>
                <td>
                    @if (User.IsInRole("Academy") && userAcademyId == academy.Id)
                    {
                        <a asp-action="Edit" asp-route-id="@academy.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-controller="TrainingSessions" asp-action="Create" asp-route-academyId="@academy.Id" class="btn btn-sm btn-outline-success">Add Training Session</a>
                    }
                    <a asp-controller="Attendances" asp-action="Index" asp-route-academyId="@academy.Id" class="btn btn-sm btn-outline-info">Attendances</a>
                    @if (User.IsInRole("Academy") && userAcademyId == academy.Id)
                    {
                        <form asp-action="Delete" asp-route-id="@academy.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>