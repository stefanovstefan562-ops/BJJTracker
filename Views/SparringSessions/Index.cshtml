@model IEnumerable<SparringSession>
@{
	ViewData["Title"] = "Sparring Sessions";
}
<h1 class="mb-4">Sparring Sessions</h1>
<a asp-action="Create" class="btn btn-primary mb-3">Add Sparring Session</a>
<table class="table table-striped table-hover align-middle">
	<thead>
		<tr>
			<th>Training</th>
			<th>Partner</th>
			<th>Belt</th>
			<th>Academy</th>
			<th>Result</th>
			<th>Actions</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var sparringSession in Model)
		{
			<tr>
				<td>@sparringSession.TrainingSession?.DateOfTheTraining</td>
				<td>@sparringSession.SparringPrtnerName</td>
				<td>@sparringSession.SparringParatnerBelt</td>
				<td>@sparringSession.SparringPartnerAcademy</td>
				<td>@sparringSession.SparringResult</td>
				<td>
					<a asp-action="Edit" asp-route-id="@sparringSession.Id" class="btn btn-sm btn-outline-primary">Edit</a>
					<form asp-action="Delete" asp-route-id="@sparringSession.Id" method="post" class="d-inline">
						<button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
					</form>
				</td>
			</tr>
		}
	</tbody>
</table>