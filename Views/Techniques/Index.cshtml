@model IEnumerable<Technique>
@{
	ViewData["Title"] = "Techniques";
}
<h1 class="mb-4">Techniques</h1>
<a asp-action="Create" class="btn btn-primary mb-3">Create New Technique</a>
<table class="table table-striped table-hover align-middle">
	<thead>
		<tr>
			<th>TechniqueName</th>
			<th>TechniquePosition</th>
			<th>TechniqueDescription</th>
			<th>TechniqueVideo</th>
			<th>Actions</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var technique in Model)
		{
			<tr>
				<td>@technique.TechniqueName</td>
				<td>@technique.TechniquePosition</td>
				<td>@technique.TechniqueDescription</td>
				<td>@technique.TechniqueVideo</td>
				<td>
					<a asp-action="Edit" asp-route-id="@technique.Id" class="btn btn-sm btn-outline-primary">Edit</a>
					<form asp-action="Delete" asp-route-id="@technique.Id" method="post" class="d-inline">
						<button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
					</form>
				</td>
			</tr>
		}
	</tbody>
</table>